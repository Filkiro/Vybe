{
  "expo": {
    "name": "Vybe",
    "slug": "vybe-app",
    "icon": "./assets/icon.png",
    "scheme": "vybe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Vybe usa suas fotos para você escolher a capa da música."
        }
      ],
      "expo-asset",
      "expo-audio"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B82F6"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.filkiro.vybeapp"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f3573d6c-58b7-45ba-a30e-68928f694b36"
      }
    }
  }
}
